# Load test environment — copy to .env and adjust if needed
MQTT_BROKER_URL=mqtt://localhost:1883
MONITORING_URL=http://localhost:3001
RABBITMQ_MGMT_URL=http://localhost:15672
RABBITMQ_USER=screenhouse
RABBITMQ_PASSWORD=screenhouse
RABBITMQ_QUEUE=sensor-ingest

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=screenhouse_monitoring

# App DB — used to select real users -> active screenhouses -> active sensor_nodes
DB_APP_HOST=localhost
DB_APP_PORT=5434
DB_APP_NAME=screenhouse_app

# Simulator
LOADTEST_MQTT_POOL_SIZE=32
LOADTEST_SIM_TICK_MS=10

# Thesis dataset seed (npm run seed:nodes)
THESIS_TARGET_SENSOR_NODES=1600
THESIS_TRAYS_PER_SCREENHOUSE=20
THESIS_PHONE_PREFIX=08270

# Metrics polling interval (ms)
METRICS_INTERVAL_MS=5000
