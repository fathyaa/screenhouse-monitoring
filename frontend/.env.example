# Dev lokal: biarkan proxy Vite (default) — tahan ganti WiFi & tes dari HP (port 5174 saja)
VITE_DEV_PROXY=true
# VITE_API_URL=http://localhost:8000
# VITE_MONITORING_URL=http://localhost:3001

# Production build (VITE_DEV_PROXY=false wajib):
# VITE_API_URL=https://your-domain
# VITE_MONITORING_URL=https://your-domain

# Web Push (VAPID public key — harus pair dengan VAPID_PRIVATE_KEY di app-service)
# Generate: cd services/app-service && npx web-push generate-vapid-keys
