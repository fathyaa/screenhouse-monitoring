        </mxCell>
        <mxCell id="subtitle" value="7 tabel — Bounded context: Ingest WSN + Aktuator + Alerting + Read-model (sync dari App DB)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="42" width="840" height="20" as="geometry" />
        </mxCell>

        <!-- Read-model -->
        <mxCell id="screenhouse_registry" value="&lt;b&gt;screenhouse_registry&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;🔑 &lt;i&gt;screenhouse_id&lt;/i&gt; INTEGER PK&lt;br&gt;owner_user_id INTEGER&lt;br&gt;screenhouse_name VARCHAR(255)&lt;br&gt;status VARCHAR(50)&lt;br&gt;updated_at TIMESTAMPTZ&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;read-model sync dari App DB&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="threshold_snapshots" value="&lt;b&gt;threshold_snapshots&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;🔑 🔗 screenhouse_id PK/FK&lt;br&gt;&lt;br&gt;&lt;b&gt;10 parameter (min/max):&lt;/b&gt;&lt;br&gt;nitrogen, phosphorus, potassium&lt;br&gt;soil_moisture, soil_temperature, soil_ph&lt;br&gt;conductivity, air_temperature&lt;br&gt;air_humidity, light_intensity&lt;br&gt;updated_at TIMESTAMPTZ&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="230" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- WSN: Sink node (gateway + relay) -->
        <mxCell id="sink_nodes" value="&lt;b&gt;sink_nodes&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;🔑 &lt;i&gt;id&lt;/i&gt; SERIAL PK&lt;br&gt;🔗 screenhouse_id FK UK&lt;br&gt;node_code VARCHAR(50) UK&lt;br&gt;node_name VARCHAR(100)&lt;br&gt;relay_channels INT DEFAULT 3&lt;br&gt;&lt;br&gt;&lt;b&gt;Status aktuator:&lt;/b&gt;&lt;br&gt;fan_status BOOLEAN&lt;br&gt;irrigation_status BOOLEAN&lt;br&gt;lamp_status BOOLEAN&lt;br&gt;is_active BOOLEAN&lt;br&gt;updated_at, created_at TIMESTAMPTZ&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;1 sink node per screenhouse&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="270" height="220" as="geometry" />
        </mxCell>

        <!-- WSN: Sensor node (tray) -->
        <mxCell id="sensor_nodes" value="&lt;b&gt;sensor_nodes&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;🔑 &lt;i&gt;id&lt;/i&gt; SERIAL PK&lt;br&gt;🔗 screenhouse_id FK&lt;br&gt;node_code VARCHAR(50) UK&lt;br&gt;node_name VARCHAR(100)&lt;br&gt;location VARCHAR(255)&lt;br&gt;send_interval_seconds INT&lt;br&gt;is_active BOOLEAN&lt;br&gt;created_at TIMESTAMPTZ&lt;/div&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666&quot;&gt;&lt;i&gt;1 node per tray bibit&lt;/i&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="260" height="160" as="geometry" />
