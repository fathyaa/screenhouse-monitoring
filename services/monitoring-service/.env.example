PORT=3001

MQTT_BROKER_URL=mqtt://localhost:1883

# --- Jembatan HiveMQ Cloud (perangkat sensor sungguhan) ---
# Jalur ingest TERPISAH dari simulator: koneksi MQTT sendiri (TLS+auth), payload
# CSV, topik gh01/node/+/parameter. Kosongkan HIVEMQ_URL untuk menonaktifkan.
# HIVEMQ_URL=mqtts://<cluster>.s1.eu.hivemq.cloud:8883
# HIVEMQ_USERNAME=
# HIVEMQ_PASSWORD=
# Peta perangkat → screenhouse: prefix:screenhouseId (koma untuk banyak perangkat)
# HIVEMQ_BRIDGES=gh01:700
# HIVEMQ_DEBUG=false

# Adapter infra cloud → format app (greenhouse/cianjur/seedling/SN-01/sensor)
# Field: npk_n→nitrogen, npk_p→phosphorus, npk_k→potassium, moisture→soil_moisture
INFRA_MQTT_TOPICS=greenhouse/+/+/+/sensor
# Opsional: lokasi infra → screenhouse_id (validasi topic; node tetap lookup dari DB)
# INFRA_MQTT_SCREENHOUSE_MAP=cianjur/seedling=1

# Simulator MQTT infra (scripts/simulate-mqtt.js)
# SIM_MQTT_CONFIG=./scripts/simulate-mqtt.config.json
# SIM_MQTT_INTERVAL_MS=60000
# SIM_MQTT_STAGGER_MS=2000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=screenhouse_monitoring
# Ukuran pool koneksi Postgres (default pg = 10; dinaikkan untuk ingest throughput).
PG_POOL_MAX=40
PG_POOL_IDLE_MS=30000

# --- Tuning ingest performa ---
# Cache lookup node/owner & threshold (ms). Set 0-kecil kalau butuh data super fresh.
INGEST_LOOKUP_TTL_MS=60000
THRESHOLD_CACHE_TTL_MS=60000
# Log per-pesan (verbose) — biarkan false saat load test / produksi.
INGEST_DEBUG=false
ALERT_DEBUG=false
SOCKET_DEBUG=false

JWT_SECRET=supersecret

REDIS_HOST=localhost
REDIS_PORT=6379

# Ingest buffer — default off (MQTT → DB). Set true untuk MQTT → RabbitMQ → DB (load test).
USE_RABBITMQ=false
RABBITMQ_URL=amqp://screenhouse:screenhouse@localhost:5672
RABBITMQ_INGEST_QUEUE=sensor-ingest
RABBITMQ_PREFETCH=20
