PORT=8000

DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=screenhouse_app

JWT_SECRET=supersecret

REDIS_HOST=localhost
REDIS_PORT=6379

MONITORING_SERVICE_URL=http://localhost:3001

# Read-only stats (device count) — same DB as monitoring-service
DB_MON_PORT=5433
DB_MON_NAME=screenhouse_monitoring

# Aktuator fisik per-screenhouse — SAMA PERSIS dengan monitoring-service/.env.
# Dipakai laporan wilayah & analytics siklus agar tidak menghitung slot aktuator
# yang dipinjam untuk fungsi lain (gh01: fan_status = katup irigasi tray 2).
# ACTUATOR_CAPABILITIES=700:irrigation=Irigasi Tray 1|fan=Irigasi Tray 2
