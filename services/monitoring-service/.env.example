PORT=3001

MQTT_BROKER_URL=mqtt://localhost:1883

# --- Jembatan perangkat sensor sungguhan (broker MQTT: HiveMQ Cloud ATAU broker lokal) ---
# Jalur ingest TERPISAH dari simulator: koneksi MQTT sendiri, payload CSV (pemisah ";"),
# topik gh01/node/+/parameter. Kosongkan DEVICE_BRIDGE_URL untuk menonaktifkan.
# HiveMQ Cloud   : DEVICE_BRIDGE_URL=mqtts://<cluster>.s1.eu.hivemq.cloud:8883
# Broker lokal   : DEVICE_BRIDGE_URL=mqtt://localhost:1883
# VPS broker sendiri (mis. mosquitto polos, allow_anonymous) — skema mqtt://
# (bukan http://), TANPA path/slash di belakang, host boleh langsung IP:
# DEVICE_BRIDGE_URL=mqtt://168.110.214.70:1883
# DEVICE_BRIDGE_USERNAME=
# DEVICE_BRIDGE_PASSWORD=
# Peta perangkat → screenhouse: prefix:screenhouseId (koma untuk banyak perangkat)
# DEVICE_BRIDGE_MAP=gh01:700
# DEVICE_BRIDGE_DEBUG=false

# Kapabilitas aktuator per-screenhouse (aktuator fisik yang ADA di perangkat).
# Format: screenhouseId:aktuator1|aktuator2 (fan, irrigation, lamp). Screenhouse
# yang tidak terdaftar dianggap punya semua aktuator. Contoh gh01 (cuma irigasi):
# ACTUATOR_CAPABILITIES=700:irrigation
#
# Tiap aktuator boleh diberi label sendiri ("aktuator=Label"). gh01 punya DUA
# katup irigasi (tray 1 & tray 2): slot `fan` dipinjam sebagai katup kedua supaya
# tidak perlu kolom DB baru, tapi ditampilkan ke petani sebagai irigasi:
# ACTUATOR_CAPABILITIES=700:irrigation=Irigasi Tray 1|fan=Irigasi Tray 2
# Nilai yang sama perlu diset juga di services/app-service/.env supaya laporan
# wilayah & analytics siklus tidak menghitung slot pinjaman itu sebagai "Kipas".

# Kontrol aktuator otomatis dari alert (default aktif). Set false agar app tidak
# menyetir aktuator sama sekali (alert tetap dibuat) — berguna saat uji koneksi device.
# AUTO_ACTUATOR_ENABLED=true

# Screenhouse yang dikecualikan dari aktuator otomatis (daftar id dipisah koma).
# WAJIB diisi untuk perangkat yang slot aktuatornya dipinjam: di gh01 slot `fan`
# adalah katup air tray 2, sedangkan rule otomatis memetakan suhu udara tinggi →
# fan ON — tanpa pengecualian ini, hari panas akan membanjiri tray 2.
# AUTO_ACTUATOR_EXCLUDE=700

# Adapter infra cloud → format app (greenhouse/cianjur/seedling/SN-01/sensor)
# Field: npk_n→nitrogen, npk_p→phosphorus, npk_k→potassium, moisture→soil_moisture
INFRA_MQTT_TOPICS=greenhouse/+/+/+/sensor
# Opsional: lokasi infra → screenhouse_id (validasi topic; node tetap lookup dari DB)
# INFRA_MQTT_SCREENHOUSE_MAP=cianjur/seedling=1

# Simulator MQTT infra (scripts/simulate-mqtt.js)
# SIM_MQTT_CONFIG=./scripts/simulate-mqtt.config.json
# SIM_MQTT_INTERVAL_MS=60000
# SIM_MQTT_STAGGER_MS=2000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=screenhouse_monitoring
# Ukuran pool koneksi Postgres (default pg = 10; dinaikkan untuk ingest throughput).
PG_POOL_MAX=40
PG_POOL_IDLE_MS=30000

# --- Tuning ingest performa ---
# Cache lookup node/owner & threshold (ms). Set 0-kecil kalau butuh data super fresh.
INGEST_LOOKUP_TTL_MS=60000
THRESHOLD_CACHE_TTL_MS=60000
# Log per-pesan (verbose) — biarkan false saat load test / produksi.
INGEST_DEBUG=false
ALERT_DEBUG=false
SOCKET_DEBUG=false

JWT_SECRET=supersecret

REDIS_HOST=localhost
REDIS_PORT=6379

# Ingest buffer — default off (MQTT → DB). Set true untuk MQTT → RabbitMQ → DB (load test).
USE_RABBITMQ=false
RABBITMQ_URL=amqp://screenhouse:screenhouse@localhost:5672
RABBITMQ_INGEST_QUEUE=sensor-ingest
RABBITMQ_PREFETCH=20
