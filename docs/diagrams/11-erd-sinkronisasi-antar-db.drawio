        <mxCell id="note" value="Garis putus = sinkronisasi logis (bukan FK lintas DB). Hanya registry + threshold_snapshots yang disalin dari App DB. sink_nodes, sensor_nodes, sensor_data, actuator_logs, alerts dikelola lokal oleh Monitoring Service." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
