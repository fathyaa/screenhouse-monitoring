PORT=3001

MQTT_BROKER_URL=mqtt://localhost:1883

# Adapter infra cloud → format app (greenhouse/cianjur/seedling/SN-01/sensor)
# Field: npk_n→nitrogen, npk_p→phosphorus, npk_k→potassium, moisture→soil_moisture
INFRA_MQTT_TOPICS=greenhouse/+/+/+/sensor
# Opsional: lokasi infra → screenhouse_id (validasi topic; node tetap lookup dari DB)
# INFRA_MQTT_SCREENHOUSE_MAP=cianjur/seedling=1

# Simulator MQTT infra (scripts/simulate-mqtt.js)
# SIM_MQTT_CONFIG=./scripts/simulate-mqtt.config.json
# SIM_MQTT_INTERVAL_MS=60000
# SIM_MQTT_STAGGER_MS=2000

DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=screenhouse_monitoring

JWT_SECRET=supersecret

REDIS_HOST=localhost
REDIS_PORT=6379

# Ingest buffer — default off (MQTT → DB). Set true untuk MQTT → RabbitMQ → DB (load test).
USE_RABBITMQ=false
RABBITMQ_URL=amqp://screenhouse:screenhouse@localhost:5672
RABBITMQ_INGEST_QUEUE=sensor-ingest
RABBITMQ_PREFETCH=20
